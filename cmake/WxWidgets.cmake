# Prefer a project-local source build on Windows. An existing SDK is optional.
if(WIN32)
  set(_wx_default_provider BUNDLED)
else()
  set(_wx_default_provider SYSTEM)
endif()
set(DIGITAL_GLOBE_WX_PROVIDER "${_wx_default_provider}" CACHE STRING "wxWidgets dependency: BUNDLED or SYSTEM")
set_property(CACHE DIGITAL_GLOBE_WX_PROVIDER PROPERTY STRINGS BUNDLED SYSTEM)

if(DIGITAL_GLOBE_WX_PROVIDER STREQUAL "BUNDLED")
  include(FetchContent)
  set(wxBUILD_SHARED OFF CACHE BOOL "" FORCE)
  set(wxBUILD_INSTALL OFF CACHE BOOL "" FORCE)
  set(wxBUILD_SAMPLES OFF CACHE STRING "" FORCE)
  set(wxBUILD_TESTS OFF CACHE STRING "" FORCE)
  set(wxBUILD_DEMOS OFF CACHE BOOL "" FORCE)
  set(wxBUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)
  set(wxBUILD_LOCALES OFF CACHE STRING "" FORCE)
  set(wxUSE_GLCANVAS ON CACHE BOOL "" FORCE)
  foreach(feature AUI HTML HELP WXHTML_HELP MEDIACTRL WEBVIEW RICHTEXT STC RIBBON PROPGRID XRC XML NET LIBTIFF LIBWEBP)
    set(wxUSE_${feature} OFF CACHE BOOL "" FORCE)
  endforeach()
  if(MSVC)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
    set(wxBUILD_USE_STATIC_RUNTIME ON CACHE BOOL "" FORCE)
  endif()
  message(STATUS "Using bundled wxWidgets 3.3.4 (static). The first build downloads and compiles it.")
  FetchContent_Declare(wxwidgets
    URL https://github.com/wxWidgets/wxWidgets/releases/download/v3.3.4/wxWidgets-3.3.4.zip
    URL_HASH SHA256=a604fe40a59e6515eac3efe58deca38b54b7ef7f3c1df0906559bde6de1e2f58
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(wxwidgets)
  set(DIGITAL_GLOBE_WX_LIBRARIES wx::core wx::base wx::gl)
  set(DIGITAL_GLOBE_WX_LICENSE "${wxwidgets_SOURCE_DIR}/docs/licence.txt")
elseif(DIGITAL_GLOBE_WX_PROVIDER STREQUAL "SYSTEM")
  if(MSVC)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
  endif()
  find_package(wxWidgets 3.2 REQUIRED COMPONENTS core base gl)
  include(${wxWidgets_USE_FILE})
  set(DIGITAL_GLOBE_WX_LIBRARIES ${wxWidgets_LIBRARIES})
  set(DIGITAL_GLOBE_WX_LICENSE "${wxWidgets_ROOT_DIR}/docs/licence.txt")
else()
  message(FATAL_ERROR "DIGITAL_GLOBE_WX_PROVIDER must be BUNDLED or SYSTEM")
endif()
